ENVIRONMENT_NAME=default
COMPOSE_PROJECT_NAME=<your-repository-name>-default
COMPOSER_VERSION=2.8
WORDPRESS_IMAGE_TAG=7.0.2-php8.3-apache
NODE_VERSION=24.5.0
PLAYWRIGHT_VERSION=1.62.1
PLAYWRIGHT_ONLY_SHELL=false
WP_CLI_VERSION=2.12.0
WP_CLI_SHA256=ce34ddd838f7351d6759068d09793f26755463b4a4610a5a5c0a97b68220d85c
XDEBUG_VERSION=3.4.5
CODEX_CLI_VERSION=0.147.0
LOGCUT_VERSION=0.1.19
WORDPRESS_HOST=127.0.0.1
WORDPRESS_PORT=8080
MAILPIT_WEB_PORT=8025
EDITOR_MODE=default
PHP_DISPLAY_ERRORS=Off
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=wordpress-root
WORDPRESS_SITE_TITLE=WordPress Development
WORDPRESS_LOCALE=ja
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=admin
WORDPRESS_ADMIN_EMAIL=admin@example.test
MCP_ADAPTER_ENABLED=false
MCP_ADAPTER_VERSION=0.5.0
MCP_ADAPTER_SHA256=a13f253c7bf4314b6cce7e238be2d5857eee66242bfe5ff5cb5576f74dc41593
LOCAL_UID=1000
LOCAL_GID=1000

TZ=Asia/Tokyo
LOCALE=ja_JP.UTF-8

WP_PROJECT_DIRECTORY=<plugins|themes>
WP_PROJECT_SLUG=<your-plugin-slug-name|your-theme-slug-name>
WP_PROJECT_SOURCE_PATH=../../<your-project-source-path>
